# Copy to .env in this folder (backend/) and fill in your key.
# Never commit .env.

# Preferred provider: Groq (fast inference). Get a key at https://console.groq.com/
GROQ_API_KEY=
# Examples: llama-3.3-70b-versatile, llama-3.1-8b-instant
GROQ_MODEL=

# Fallback / alternate provider: Google Gemini
GEMINI_API_KEY=

# Required for Gemini chat: model id only from env (no default in code). After GEMINI_API_KEY is set,
# run GET /api/gemini/models and copy an `id` value here.
GEMINI_MODEL=

# Provider selection: auto (default, prefers Groq when configured), groq, or gemini
# AI_PROVIDER=auto

# When both providers are configured, fall back to the other on failure (default on). Set to 0 to disable.
# AI_FALLBACK=1

# Optional (defaults shown in server)
# Stop AI calls before Vercel/serverless max duration (ms). Default 45000.
# CHAT_REQUEST_TIMEOUT_MS=45000
# GEMINI_REQUEST_TIMEOUT_MS=45000

# PORT=3001
# Comma-separated CORS origins (your frontend URL(s)). Required for cross-origin dev/production.
# Must match the browser tab origin exactly (scheme + host + port). Include preview URLs if you test them.
# CLIENT_ORIGIN=http://localhost:5173
# CLIENT_ORIGIN=http://localhost:5173,https://your-app.vercel.app,https://your-app-git-branch.vercel.app

# Set to 0 to disable per-request handler logs from wrapApi (cold-start lines still log).
# LOG_REQUESTS=0

# Per-client limit on POST /api/chat (protects AI API quota)
# CHAT_RATE_LIMIT_MAX=3
# CHAT_RATE_LIMIT_WINDOW_MS=60000

# Behind a reverse proxy, set to 1 so req.ip uses X-Forwarded-For
# TRUST_PROXY=1
